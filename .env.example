# monday.com App OAuth Client ID (from Developer Center > Features / OAuth)
VITE_CLIENT_ID=

# Backend Server Root URL (without /api suffix)
# Used for OAuth callback redirect URI: ${VITE_BACKEND_URL}/api/auth/callback
VITE_BACKEND_URL=http://localhost:3000

# Backend API Base URL for HTTP requests (defaults to "/api" if omitted)
VITE_API_BASE_URL=http://localhost:3000/api

# Frontend URL Origin (used for redirecting user to ${VITE_FRONTEND_URL}/auth-success after OAuth)
# Defaults to window.location.origin if omitted
VITE_FRONTEND_URL=http://localhost:5173
